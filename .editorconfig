root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{json,yaml,yml,toml,iss}]
indent_size = 2

; Inno Setup 脚本含中文，必须带 BOM 才能被编译器正确识别为 UTF-8
[*.iss]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.svg]
insert_final_newline = false
